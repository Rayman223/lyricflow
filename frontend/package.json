{
    "name": "lyricflow",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "format": "prettier --write src tests *.ts *.json index.html",
        "format:check": "prettier --check src tests *.ts *.json index.html",
        "dev": "vite --host 127.0.0.1",
        "build": "vue-tsc --noEmit && vite build",
        "test": "vitest run",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@coderline/alphatab": "1.8.4",
        "idb": "^8.0.0",
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@coderline/alphatab-vite": "1.8.4",
        "@playwright/test": "^1.56.0",
        "@types/node": "^22.0.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "fake-indexeddb": "^6.2.0",
        "prettier": "^3.9.10",
        "typescript": "^5.9.0",
        "vite": "^8.3.4",
        "vite-plugin-pwa": "^1.0.0",
        "vitest": "^4.0.0",
        "vue-tsc": "^3.0.0"
    }
}
