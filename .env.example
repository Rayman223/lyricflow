APP_NAME=LyricFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Leave accounts disabled until the dedicated database has been migrated.
LYRICFLOW_ACCOUNTS_ENABLED=false
LYRICFLOW_EMAIL_ENABLED=false
TRUSTED_PROXIES=

# Never reuse another application's database or credentials.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lyricflow
DB_USERNAME=lyricflow
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=LyricFlow

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Dedicated LyricFlow Payment Link: one-off donations, customer chooses the EUR amount.
SUPPORT_YEARLY_GOAL_EUR=260
STRIPE_DONATION_URL=
STRIPE_DONATION_PAYMENT_LINK_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVEMODE=true
