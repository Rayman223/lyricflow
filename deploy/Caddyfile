{
	auto_https off
	admin off
	frankenphp
}

http://:8080 {
	root * /app/public
	encode zstd gzip

	@hidden path_regexp hidden (^|/)\.
	respond @hidden 404

	@bundles path /assets/*
	header @bundles Cache-Control "public, max-age=31536000, immutable"

	@shell path / /index.html /sw.js /manifest.webmanifest /workbox-*.js
	header @shell Cache-Control "no-cache"
	header X-Content-Type-Options nosniff
	header X-Frame-Options SAMEORIGIN

	php_server
}
