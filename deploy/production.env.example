APP_NAME=LyricFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lyricflow.example.invalid
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.invalid
MAIL_FROM_NAME=LyricFlow

# Enable only after following docs/AUTO_HEBERGEMENT.md.
LYRICFLOW_ACCOUNTS_ENABLED=false
LYRICFLOW_EMAIL_ENABLED=false
TRUSTED_PROXIES=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lyricflow.example.invalid/auth/google/callback

# See docs/SUPPORT.md before enabling donations and automatic tracking.
SUPPORT_YEARLY_GOAL_EUR=260
STRIPE_DONATION_URL=
STRIPE_DONATION_PAYMENT_LINK_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVEMODE=true

# No database connection is needed while accounts remain disabled.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lyricflow
DB_USERNAME=lyricflow
DB_PASSWORD=
